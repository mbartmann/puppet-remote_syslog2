{
  "name": "mbartmann-remote_syslog2",
  "version": "1.0.1",
  "author": "mbartmann",
  "summary": "Install and configure Papertrail's remote_syslog2",
  "license": "MIT",
  "source": "https://github.com/mbartmann/puppet-remote_syslog2",
  "project_page": "https://github.com/mbartmann/puppet-remote_syslog2",
  "issues_url": "https://github.com/mbartmann/puppet-remote_syslog2/issues",
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.0.0 < 9.0.0"
    }
  ],
  "dependencies": [
    {
      "name": "puppetlabs-stdlib",
      "version_requirement": ">= 9.0.0 < 10.0.0"
    },
    {
      "name": "rehan-wget",
      "version_requirement": ">= 1.3.3"
    }
  ],
  "operatingsystem_support": [
    {
    "operatingsystem":"Debian",
    "operatingsystemrelease":[ "10", "11", "12" ]
    },
    {
    "operatingsystem": "Ubuntu",
    "operatingsystemrelease": [ "18.04", "20.04", "22.04" ]
    }
   ]
}
